# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret key (sb_secret_...): SÓ no servidor. Nunca com prefixo NEXT_PUBLIC_
# e nunca no GitHub. Usada para criar logins pela tela de Usuários.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
